ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Shared secret — the web app sends this as the X-Api-Secret header.
# Must match SAO_API_SECRET in apps/web/.env.local
API_SECRET=dev-sao-secret-change-me
# Local dev port (see `pnpm dev:sao`). Only used when running `python main.py`;
# the pnpm script passes --port 8200 explicitly.
PORT=8200
